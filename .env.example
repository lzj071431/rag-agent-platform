# ============================================================
# 环境变量示例 —— 复制为 .env 后填入真实值
#   copy .env.example .env
#
# 全部配置由 core/config.py 的 Pydantic Settings 统一加载，
# 代码中不再出现任何 os.getenv()。
# 变量名大小写不敏感，Shell 环境变量优先级高于 .env。
#
# 【命名规则】
#   1. 首选带 APP_ 前缀的名字（如 APP_MODEL_NAME），可避免与宿主机 /
#      CI / 其它 Python 包的通用变量名（DEBUG、MODEL_NAME、APP_NAME）冲突。
#   2. 项目专属变量保留无前缀旧名兼容（DEEPSEEK_API_KEY、FEISHU_WEBHOOK_URL、
#      PERSIST_DIR 等），既有 .env 无需改动即可继续工作。
#   3. 嵌套配置各自使用独立前缀：CHUNK_* 与 RETRIEVAL_*。
#
#   注意：通用变量名（DEBUG / MODEL_NAME / APP_NAME / LOG_LEVEL / LOG_FORMAT）
#   **只认带 APP_ 前缀的版本**，无前缀写法会被刻意忽略以防被外部环境劫持。
# ============================================================

# ---------------- 大模型（必填）----------------
# DeepSeek 平台申请：https://platform.deepseek.com/api_keys
# 旧名 DEEPSEEK_API_KEY 同样有效
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
APP_MODEL_NAME=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=120

# ---------------- 重试策略（Tenacity 指数退避）----------------
# 最多尝试 3 次：2s -> 4s -> 8s（叠加 0~1s 随机抖动）
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_WAIT=2
RETRY_MAX_WAIT=30
RETRY_EXPONENTIAL_BASE=2

# ---------------- 向量库 ----------------
PERSIST_DIR=./chroma_db
COLLECTION_NAME=rag_kb
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ---------------- 外部集成 ----------------
# 飞书群机器人 Webhook（周报自动推送）
FEISHU_WEBHOOK_URL=
WEBHOOK_TIMEOUT_SECONDS=10

# ---------------- 日志 ----------------
# text：本地开发可读；json：线上日志采集
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=text
LOG_DIR=./logs
LOG_FILE_ENABLED=true
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ---------------- 应用 ----------------
APP_DEBUG=false
REPORT_OUTPUT_PATH=./competitor_analysis_report.md

# ---------------- 切分参数（嵌套配置，前缀 CHUNK_）----------------
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ---------------- 检索参数（嵌套配置，前缀 RETRIEVAL_）----------------
RETRIEVAL_VECTOR_K=15
RETRIEVAL_BM25_K=15
RETRIEVAL_FINAL_K=10
RETRIEVAL_RRF_C=60
RETRIEVAL_BM25_WEIGHT=1.5
RETRIEVAL_ENABLE_HYBRID=true
RETRIEVAL_ENABLE_MULTI_QUERY=false
RETRIEVAL_RELEVANCE_DISTANCE_THRESHOLD=1.05
